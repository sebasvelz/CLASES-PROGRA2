Tablero


package com.class_arreglos;

public class Tablero {

    private final int dimension = 3;
    private char[][] cuadricula = new char[dimension][dimension];

    public void imprimirtablero() {
        System.out.println("+---+---+---+");

        for (int i = 0; i < dimension; i++) {
            System.out.print("|");

            for (int j = 0; j < dimension; j++) {
                System.out.print(" " + cuadricula[i][j] + " |");
            }

            System.out.println();
            System.out.println("+---+---+---+");
        }
    }

    public void asignararValor(int fila, int columna, char caracter) {
        tablero[fila][columna] = caracter;
    }

    public boolean comprobarGanador(char caracter) {
    	boolean filaCompleta=true;
        for (int i = 0; i < tablero.length; i++) {
            for(int j=0;j<tablero[i];j++) {
            	if(!(tablero[i][j]==(caracter))) {
            		filaCompleta=false;
            		break;
            	}
            }
        }

        return filaCompleta;
    }
}


Main



package com.class_arreglos;

import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        boolean turno = true;
        char caracter = 'X';

        Scanner t = new Scanner(System.in);
        Tablero tablero = new Tablero();

        while (true) {

            if (turno) {
                System.out.println("Turno del jugador 1");
                caracter = 'X';
                turno = false;
            } else {
                System.out.println("Turno del jugador 2");
                caracter = 'O';
                turno = true;
            }

            tablero.imprimirtablero();

            System.out.print("Ingrese fila (0-2): ");
            int fila = t.nextInt();

            System.out.print("Ingrese columna (0-2): ");
            int columna = t.nextInt();

            System.out.println();

            tablero.asignararValor(fila, columna, caracter);

            if (tablero.comprobarGanador()) {
                tablero.imprimirtablero();
                System.out.println("¡El jugador " +
                    (caracter == 'X' ? "1" : "2") +
                    " ha ganado!");
                break;
            }
        }

        t.close();
    }
}

